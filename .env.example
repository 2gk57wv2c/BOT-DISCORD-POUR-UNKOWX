# Discord Bot Configuration
# Copie ce fichier en .env et remplace les valeurs 0 par les vrais IDs.
# Ne publie jamais le vrai token Discord.

DISCORD_TOKEN=replace-with-your-discord-token
BOT_PREFIX=!

# Deux propriétaires du bot : remplace les deux 0 par leurs IDs Discord.
BOT_OWNER_ID=0
CO_OWNER_IDS=0
GLOBAL_ADMIN_IDS=
GUILD_ID=0

# Optional server configuration
LOG_CHANNEL_ID=0
SUPPORT_SERVER=
DASHBOARD_URL=
DEV_CREDITS=

# Urgence Nexus (localhost uniquement, aucun IP membre) — laisser vide pour désactiver
NEXUS_SECRET=
NEXUS_PORT=8765

# Database
DATABASE_URL=sqlite:///./data/database.db

# Features
ENABLE_MUSIC=false
ENABLE_TICKETS=true
ENABLE_LOGS=true
ENABLE_MESSAGE_CONTENT=true
ENABLE_MEMBERS=true
BOT_ACTIVITY=En ligne
