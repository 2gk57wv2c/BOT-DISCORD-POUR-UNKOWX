# Discord Bot Configuration
# Copie ce fichier en .env et remplace les valeurs 0 par les vrais IDs.

DISCORD_TOKEN=replace-with-your-discord-token
BOT_PREFIX=!
BOT_OWNER_ID=0
CO_OWNER_IDS=0
GLOBAL_ADMIN_IDS=
GUILD_ID=0
LOG_CHANNEL_ID=0
SUPPORT_SERVER=
DASHBOARD_URL=
DEV_CREDITS=
NEXUS_SECRET=
NEXUS_PORT=8765
DATABASE_URL=sqlite:///./data/database.db
ENABLE_MUSIC=false
ENABLE_TICKETS=true
ENABLE_LOGS=true
ENABLE_MESSAGE_CONTENT=true
ENABLE_MEMBERS=true
BOT_ACTIVITY=SITE-453 — FALL FROM THE SKY
